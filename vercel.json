{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/prototype/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/forum/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signin",
      "destination": "/index.html"
    }
  ]
}
